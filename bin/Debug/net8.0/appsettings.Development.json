{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SmartRecruitmentDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "MatchPoint",
    "Audience": "MatchPointClient",
    "Key": "matchpoint-development-signing-key-change-me-in-production",
    "ExpiryMinutes": 480
  },
  "Matching": {
    "SkillsWeight": 60,
    "ExperienceWeight": 20,
    "EducationWeight": 10,
    "LocationWeight": 10
  },
  "FileUpload": {
    "MaxFileSizeBytes": 5242880,
    "StorageFolder": "Storage/CVs"
  },
  "Cache": {
    "VacancyMinutes": 5,
    "MatchMinutes": 5,
    "DashboardMinutes": 3
  }
}
